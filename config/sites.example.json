{
  "sites": [
    {
      "name": "example-site",
      "url": "https://example.com/login",
      "credentials": {
        "username": "your_username",
        "password": "your_password"
      },
      "selectors": {
        "username_input": "#username",
        "password_input": "#password",
        "submit_button": "button[type='submit']",
        "success_indicator": ".dashboard",
        "failure_indicator": ".error-message"
      },
      "navigate": [
        {"click": ".menu-reports", "wait_for": ".reports-page"},
        {"click": ".report-item:first-child", "wait_after": 1},
        {"url": "https://example.com/dashboard/settings"}
      ],
      "scrape": {
        "target_url": null,
        "data_selectors": {
          "account_balance": ".balance-display",
          "last_login": ".last-login",
          "notifications": [".notification-item", ".alert-banner"]
        }
      }
    }
  ]
}
